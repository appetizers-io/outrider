{
  "name": "outrider",
  "version": "0.1.0",
  "displayName": "Outrider",
  "description": "Turn GitHub PR activity into a review inbox and read-only snapshot reviews.",
  "author": "appetizers-io",
  "agents": [
    "agents/reviewer.json",
    "agents/setup.json"
  ],
  "ui": {
    "entry": "index.mjs",
    "pages": [
      {
        "route": "/apps/outrider",
        "label": "Outrider",
        "icon": "GitPullRequest",
        "iconUrl": "logo.svg"
      }
    ]
  },
  "backend": {
    "entryPoint": "backend/server.py",
    "type": "python",
    "port": "auto",
    "healthCheck": "/health"
  },
  "permissions": {
    "api": [
      "/apps/outrider/api",
      "/api/spawn",
      "/api/chat/folders",
      "/api/chat/slots",
      "/api/chat"
    ],
    "network": true,
    "storage": true
  },
  "dependencies": {
    "commands": [
      "outrider",
      "gh",
      "python3"
    ]
  },
  "platform": {
    "os": [
      "macos",
      "linux"
    ]
  },
  "mcpServers": {
    "outrider": {
      "command": "python3",
      "args": [
        "-c",
        "from kiro_crew.apps.manager import app_dir; import runpy; runpy.run_path(str(app_dir(\"outrider\") / \"backend/mcp_server.py\"), run_name=\"__main__\")"
      ]
    }
  }
}
