{
  "name": "outrider",
  "version": "0.1.0",
  "displayName": "Outrider",
  "description": "GitHub PR work queue with automatic Crew sessions. Source and support: https://github.com/appetizers-io/outrider",
  "author": "appetizers-io",
  "agents": [
    "agents/reviewer.json",
    "agents/setup.json"
  ],
  "ui": {
    "entry": "index.mjs",
    "pages": [
      {
        "route": "/apps/outrider",
        "label": "Outrider",
        "icon": "GitPullRequest",
        "iconUrl": "logo.svg"
      }
    ]
  },
  "backend": {
    "entryPoint": "backend/server.py",
    "type": "python",
    "port": "auto",
    "healthCheck": "/health"
  },
  "permissions": {
    "api": [
      "/apps/outrider/api",
      "/api/spawn",
      "/api/chat/folders",
      "/api/chat/slots",
      "/api/chat",
      "/api/notifications/push",
      "/api/agents"
    ],
    "network": true,
    "storage": true,
    "sessionApproval": true
  },
  "dependencies": {
    "commands": [
      "outrider",
      "gh",
      "git",
      "python3"
    ]
  },
  "platform": {
    "os": [
      "macos",
      "linux"
    ]
  },
  "mcpServers": {
    "outrider": {
      "command": "python3",
      "args": [
        "-c",
        "from kiro_crew.apps.manager import app_dir; import runpy; runpy.run_path(str(app_dir(\"outrider\") / \"backend/mcp_launcher.py\"), run_name=\"__main__\")"
      ]
    }
  },
  "notifications": {
    "channels": [
      {
        "id": "sessions",
        "name": "Outrider sessions",
        "icon": "GitPullRequest"
      }
    ]
  },
  "license": "Apache-2.0",
  "minKiroCrewVersion": "0.9.0",
  "tags": [
    "github",
    "pull-requests",
    "code-review",
    "developer-tools"
  ],
  "jobFamilies": [
    "Engineering"
  ],
  "repo": "https://github.com/appetizers-io/outrider",
  "iconPath": "assets/icon.png",
  "heroImageDetail": "assets/banner.png",
  "heroImageDetailDark": "assets/banner.png",
  "highlights": [
    "Turn GitHub PR activity into a durable, filterable work queue",
    "Start Crew sessions in isolated worktrees of your local checkout",
    "Configure triggers and workflows per repository, or import CLI YAML",
    "Choose reviewer members and trust settings with repository overrides",
    "Keep task context and ownership rules consistent with Outrider CLI"
  ]
}
